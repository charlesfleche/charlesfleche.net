{% extends "base.html.j2" %}

{% block main %}

<article>

  <header>
    <h1>{{ title }}</h1>
    <time datetime="{{ date }}">{{ date }}</time>
  </header>

  {{ content_path | read_text }}

</article>

{# Articles and TILs only: drafts and pages have no previous and next #}
{% if category in ("article", "til") %}
<nav class="adjacent" aria-label="{{ 'Articles précédent et suivant' if lang == 'fr' else 'Previous and next articles' }}">
  <a rel="prev" href="{{ previous.path }}">← {{ previous.title }}</a>
  <a rel="next" href="{{ next.path }}">{{ next.title }} →</a>
</nav>
{% endif %}

{% endblock main %}
