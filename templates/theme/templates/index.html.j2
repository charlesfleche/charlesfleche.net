{% extends "base.html.j2" %}

{% block main %}
<article>
  <header>
    <h1>{{ title }}</h1>
  </header>

  {{ content_path | read_text }}

  {% for cat_key, cat_name in [("article", "Articles"), ("til", "#TIL")] %}
  <h1>{{ cat_name }}</h1>

  {% for article in articles.by_category[cat_key] %}
  <p>
    <time datetime="{{ article.date }}">{{ article.date }}</time>
    <a href={{ article.path }}>{{ article.title }}</a><br />{{ article.description }}
  </p>
  {% endfor %}
  {% endfor %}
</article>


{% endblock main %}
